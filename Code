<script>
(function(){
  var D=JSON.parse(document.getElementById('pdata').textContent);
  var fmtM=function(n){return '$'+(n/1e6).toFixed(2)+'M';};
  var fmtK=function(n){return '$'+Math.round(n).toLocaleString();};
  var pct=function(n){return (n*100).toFixed(1)+'%';};

  document.getElementById('k-odc').textContent=fmtM(D.kpi.odc);
  document.getElementById('k-com').textContent=fmtK(D.kpi.committed);
  document.getElementById('k-unc').innerHTML=fmtM(D.kpi.uncommitted);
  document.getElementById('k-pop').textContent=pct(D.kpi.popRemain);

  // pace gauges
  document.getElementById('g-pop').textContent=pct(D.kpi.popElapsed);
  document.getElementById('g-odc').textContent=pct(D.kpi.odcCommitted);
  requestAnimationFrame(function(){
    document.getElementById('gf-pop').style.width=(D.kpi.popElapsed*100)+'%';
    document.getElementById('gf-odc').style.width=(D.kpi.odcCommitted*100)+'%';
  });
  var gap=((D.kpi.popElapsed-D.kpi.odcCommitted)*100).toFixed(0);
  document.getElementById('pace-note').innerHTML='A <b>'+gap+'-point gap</b> between time consumed and funds committed. On a linear plan the program should be near fully committed by now; it is not.';

  // donut
  var C=2*Math.PI*52, com=D.kpi.odcCommitted, dash=com*C;
  document.getElementById('donut').innerHTML=
    '<circle cx="70" cy="70" r="52" fill="none" stroke="#D3DAE1" stroke-width="16"/>'+
    '<circle cx="70" cy="70" r="52" fill="none" stroke="var(--accent)" stroke-width="16" stroke-dasharray="'+dash.toFixed(1)+' '+(C-dash).toFixed(1)+'" transform="rotate(-90 70 70)" stroke-linecap="butt"/>';
  document.getElementById('donut-big').textContent=pct(D.kpi.pctLeft);
  document.getElementById('dl-com').textContent=fmtK(D.kpi.committed)+' ('+pct(com)+')';
  document.getElementById('dl-unc').textContent=fmtM(D.kpi.uncommitted)+' ('+pct(D.kpi.pctLeft)+')';

  function barRow(label,val,max,cls,sub){var w=max>0?Math.max(2,Math.round(val/max*100)):0;
    return '<div class="brow"><div class="bl"><span>'+label+'</span><b>'+fmtK(val)+'</b></div><div class="btrack"><div class="bfill '+cls+'" style="width:'+w+'%"><span class="bsub">'+(sub||'')+'</span></div></div></div>';}
  document.getElementById('ov-travel').innerHTML=barRow('Authorized',D.kpi.tAuth,D.kpi.tAuth,'')+barRow('Spent',D.kpi.tSpent,D.kpi.tAuth,'steel')+barRow('Pending',D.kpi.tPend,D.kpi.tAuth,'amber');
  document.getElementById('ov-supply').innerHTML=barRow('Authorized',D.kpi.sAuth,D.kpi.sAuth,'')+barRow('Spent',D.kpi.sSpent,D.kpi.sAuth,'steel',(D.kpi.sSpent/D.kpi.sAuth*100).toFixed(1)+'% used');
  var rmax=Math.max.apply(null,D.region.map(function(r){return r.spent;}));
  document.getElementById('regionBars').innerHTML=D.region.map(function(r){return barRow(r.region+' ('+r.trips+' trips)',r.spent,rmax,r.region==='Unspecified'?'amber':'');}).join('');
  var smax=Math.max.apply(null,D.rows.map(function(r){return r.sSpent;}))||1;
  document.getElementById('supplyBars').innerHTML=D.rows.filter(function(r){return r.sSpent>0;}).map(function(r){return barRow(r.m,r.sSpent,smax,'steel');}).join('');

  // monthly table
  var tb=document.querySelector('#monTbl tbody');var sortKey='m',sortAsc=true;
  function renderTbl(){var rows=D.rows.slice().sort(function(a,b){var x=a[sortKey],y=b[sortKey];if(typeof x==='string')return sortAsc?(x<y?-1:1):(x>y?-1:1);return sortAsc?x-y:y-x;});
    tb.innerHTML=rows.map(function(r){return '<tr><td class="lft">'+r.m+'</td><td>'+fmtK(r.tSpent)+'</td><td>'+fmtK(r.tPend)+'</td><td>'+fmtK(r.sSpent)+'</td><td>'+fmtK(r.totSP)+'</td><td>'+fmtK(r.uncomm)+'</td><td class="pos">'+pct(r.pctLeft)+'</td></tr>';}).join('');
    document.querySelectorAll('#monTbl th').forEach(function(th){th.classList.toggle('sorted',th.dataset.s===sortKey);th.classList.toggle('asc',th.dataset.s===sortKey&&sortAsc);});}
  document.querySelectorAll('#monTbl th').forEach(function(th){th.addEventListener('click',function(){var k=th.dataset.s;if(k===sortKey)sortAsc=!sortAsc;else{sortKey=k;sortAsc=(k==='m');}renderTbl();});});
  renderTbl();

  // variance bars
  (function(){var svg=document.getElementById('varSvg');var L=64,R=800,T=16,B=180,W=R-L,H=B-T;
    var vals=D.rows.map(function(r,i){return D.burn.actual[i+1]-D.burn.planned[i+1];});
    var mx=Math.max.apply(null,vals);var bw=W/vals.length*0.62;var s='';
    [0,.25,.5,.75,1].forEach(function(g){var y=B-H*g;s+='<line x1="'+L+'" y1="'+y+'" x2="'+R+'" y2="'+y+'" stroke="var(--rule)"/>';s+='<text x="'+(L-8)+'" y="'+(y+3)+'" font-family="var(--mono)" font-size="9.5" fill="var(--ink-3)" text-anchor="end">+'+Math.round(mx*g*100)+'</text>';});
    vals.forEach(function(v,i){var x=L+W*(i+0.5)/vals.length;var h=H*(v/mx);s+='<rect class="vbar" x="'+(x-bw/2).toFixed(1)+'" y="'+(B-h).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+h.toFixed(1)+'" fill="var(--accent)"><title>'+D.rows[i].m+': +'+(v*100).toFixed(1)+' pts ahead of plan</title></rect>';
      if(i%2===0||i===vals.length-1)s+='<text x="'+x.toFixed(1)+'" y="'+(B+16)+'" font-family="var(--mono)" font-size="9" fill="var(--ink-3)" text-anchor="middle">'+D.rows[i].m+'</text>';});
    svg.innerHTML=s;})();

  // composition stacked bars
  (function(){var svg=document.getElementById('compSvg');var L=64,R=800,T=16,B=250,W=R-L,H=B-T;
    var mx=Math.max.apply(null,D.rows.map(function(r){return r.totSP;}));var bw=W/D.rows.length*0.6;var s='';
    [0,.5,1].forEach(function(g){var y=B-H*g;s+='<line x1="'+L+'" y1="'+y+'" x2="'+R+'" y2="'+y+'" stroke="var(--rule)"/>';s+='<text x="'+(L-8)+'" y="'+(y+3)+'" font-family="var(--mono)" font-size="9.5" fill="var(--ink-3)" text-anchor="end">$'+Math.round(mx*g/1000)+'K</text>';});
    D.rows.forEach(function(r,i){var x=L+W*(i+0.5)/D.rows.length;var ht=H*(r.tSP/mx);var hs=H*(r.sSP/mx);
      s+='<rect class="cseg" x="'+(x-bw/2).toFixed(1)+'" y="'+(B-ht).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+ht.toFixed(1)+'" fill="var(--steel)"><title>'+r.m+' Travel: '+fmtK(r.tSP)+'</title></rect>';
      s+='<rect class="cseg" x="'+(x-bw/2).toFixed(1)+'" y="'+(B-ht-hs).toFixed(1)+'" width="'+bw.toFixed(1)+'" height="'+hs.toFixed(1)+'" fill="var(--accent)"><title>'+r.m+' Supply: '+fmtK(r.sSP)+'</title></rect>';
      s+='<text x="'+x.toFixed(1)+'" y="'+(B+16)+'" font-family="var(--mono)" font-size="9" fill="var(--ink-3)" text-anchor="middle">'+r.m.split(' ')[0]+'</text>';});
    svg.innerHTML=s;})();

  // burn curve
  var svg=document.getElementById('burnSvg'),tip=document.getElementById('burnTip');var show={actual:true,planned:true};
  var L=64,R=784,T=28,B=286,W=R-L,H=B-T;var labels=D.burn.labels,act=D.burn.actual,pl=D.burn.planned,N=labels.length;
  function X(i){return L+W*i/(N-1);}function Y(v){return B-H*v;}
  function draw(){var s='';[0,.25,.5,.75,1].forEach(function(g){var y=Y(g);s+='<line x1="'+L+'" y1="'+y+'" x2="'+R+'" y2="'+y+'" stroke="var(--rule)"/>';s+='<text x="'+(L-8)+'" y="'+(y+3)+'" font-family="var(--mono)" font-size="10" fill="var(--ink-3)" text-anchor="end">'+(g*100)+'%</text>';});
    labels.forEach(function(lb,i){if(i%2===0||i===N-1)s+='<text x="'+X(i)+'" y="304" font-family="var(--mono)" font-size="9.5" fill="var(--ink-3)" text-anchor="middle">'+lb+'</text>';});
    function poly(arr,col,dash){var pts=arr.map(function(v,i){return X(i)+','+Y(v);}).join(' ');return '<polyline points="'+pts+'" fill="none" stroke="'+col+'" stroke-width="'+(dash?1.8:2.4)+'"'+(dash?' stroke-dasharray="5 4" opacity="0.85"':'')+'/>';}
    if(show.planned)s+=poly(pl,'var(--steel)',true);
    if(show.actual){s+=poly(act,'var(--accent)',false);act.forEach(function(v,i){s+='<circle cx="'+X(i)+'" cy="'+Y(v)+'" r="3" fill="var(--accent)"/>';});}
    s+='<line id="guide" x1="0" y1="'+T+'" x2="0" y2="'+B+'" stroke="var(--ink)" stroke-width="1" opacity="0" stroke-dasharray="3 3"/>';svg.innerHTML=s;}
  draw();
  svg.addEventListener('mousemove',function(e){var r=svg.getBoundingClientRect();var mx=(e.clientX-r.left)/r.width*820;var i=Math.round((mx-L)/W*(N-1));if(i<0)i=0;if(i>N-1)i=N-1;
    var g=svg.querySelector('#guide');if(g){g.setAttribute('x1',X(i));g.setAttribute('x2',X(i));g.setAttribute('opacity','0.5');}
    var vari=(act[i]-pl[i]);tip.hidden=false;tip.innerHTML='<b>'+labels[i]+'</b><br>'+(show.actual?'<span class="a">Actual '+pct(act[i])+'</span><br>':'')+(show.planned?'<span class="p">Planned '+pct(pl[i])+'</span><br>':'')+'Variance +'+(vari*100).toFixed(1)+' pts';
    tip.style.left=(X(i)/820*r.width)+'px';tip.style.top=(Y(Math.max(act[i],pl[i]))/340*r.height)+'px';});
  svg.addEventListener('mouseleave',function(){tip.hidden=true;var g=svg.querySelector('#guide');if(g)g.setAttribute('opacity','0');});
  document.querySelectorAll('#burnLegend .lg').forEach(function(bn){bn.addEventListener('click',function(){var k=bn.dataset.series;show[k]=!show[k];bn.classList.toggle('off',!show[k]);bn.classList.toggle('on',show[k]);draw();});});

  // tabs
  var tabs=document.querySelectorAll('#dbTabs .tab');
  tabs.forEach(function(t){t.addEventListener('click',function(){tabs.forEach(function(x){x.classList.remove('active');});t.classList.add('active');var tgt=t.dataset.tab;document.querySelectorAll('.panel').forEach(function(p){p.classList.toggle('active',p.dataset.panel===tgt);});});});
})();
</script>
