<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>D. Sprague — Knowesis Operations Brief</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#E7EAEE;
    --surface:#FFFFFF;
    --surface-2:#F2F4F7;
    --cover:#12161C;
    --cover-2:#1A212A;
    --ink:#13171E;
    --ink-2:#4C5967;
    --ink-3:#79838F;
    --rule:#CBD2DA;
    --rule-dark:#2C353F;
    --accent:#1C6E5A;
    --accent-deep:#124C3E;
    --accent-soft:#E4F0EB;
    --steel:#33506B;
    --signal:#B0821F;
    --display:"Space Grotesk",system-ui,sans-serif;
    --body:"IBM Plex Sans",system-ui,sans-serif;
    --mono:"IBM Plex Mono",ui-monospace,monospace;
  }

  *{box-sizing:border-box;margin:0;padding:0;}

  html{scroll-behavior:smooth;}

  body{
    font-family:var(--body);
    background:var(--paper);
    color:var(--ink);
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }

  ::selection{background:var(--accent);color:#fff;}

  a{color:inherit;}

  :focus-visible{
    outline:2px solid var(--accent);
    outline-offset:3px;
  }

  /* ---------- marking banner ---------- */
  .marking{
    background:var(--accent);
    color:#EAF4EF;
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.14em;
    text-transform:uppercase;
    padding:7px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:14px;
    flex-wrap:wrap;
  }
  .marking .dot{
    display:inline-block;width:7px;height:7px;border-radius:50%;
    background:var(--signal);margin-right:8px;
    box-shadow:0 0 0 3px rgba(176,130,31,.25);
    vertical-align:middle;
  }
  .marking span{opacity:.92;}

  .wrap{max-width:1080px;margin:0 auto;padding:0 24px;}

  /* ---------- cover / hero ---------- */
  .cover{
    background:var(--cover);
    color:#E7EBEF;
    border-bottom:3px solid var(--accent);
    position:relative;
    overflow:hidden;
  }
  .cover::before{
    content:"";
    position:absolute;inset:0;
    background-image:
      linear-gradient(rgba(255,255,255,.028) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.028) 1px,transparent 1px);
    background-size:34px 34px;
    mask-image:radial-gradient(120% 80% at 78% 0%,#000 20%,transparent 75%);
    -webkit-mask-image:radial-gradient(120% 80% at 78% 0%,#000 20%,transparent 75%);
    pointer-events:none;
  }
  .cover .wrap{position:relative;padding:52px 24px 46px;}

  .eyebrow{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:.28em;
    text-transform:uppercase;
    color:var(--signal);
    margin-bottom:22px;
    display:flex;align-items:center;gap:12px;
  }
  .eyebrow::after{content:"";height:1px;flex:1;background:var(--rule-dark);}

  h1.hero{
    font-family:var(--display);
    font-weight:600;
    font-size:clamp(30px,5.4vw,54px);
    line-height:1.02;
    letter-spacing:-.02em;
    margin-bottom:8px;
  }
  .hero-role{
    font-family:var(--mono);
    font-size:13px;
    letter-spacing:.06em;
    color:#9FB0AC;
    margin-bottom:30px;
  }
  .hero-role b{color:var(--accent);font-weight:600;}

  .bluf{
    max-width:44ch;
    font-size:clamp(16px,2.2vw,19px);
    color:#C6CEd6;
    line-height:1.5;
    border-left:2px solid var(--accent);
    padding-left:18px;
    margin-bottom:38px;
  }
  .bluf strong{color:#fff;font-weight:600;}

  /* product header block */
  .header-block{
    border:1px solid var(--rule-dark);
    background:rgba(255,255,255,.02);
    font-family:var(--mono);
    font-size:12.5px;
  }
  .hb-row{
    display:grid;
    grid-template-columns:150px 1fr;
    border-bottom:1px solid var(--rule-dark);
  }
  .hb-row:last-child{border-bottom:none;}
  .hb-k{
    padding:10px 16px;
    color:var(--accent);
    letter-spacing:.1em;
    text-transform:uppercase;
    font-size:11px;
    border-right:1px solid var(--rule-dark);
    background:rgba(28,110,90,.06);
  }
  .hb-v{padding:10px 16px;color:#D4DBE1;}

  /* ---------- metric readout ---------- */
  .readout{
    background:var(--cover-2);
    border-top:1px solid var(--rule-dark);
  }
  .readout .grid{
    display:grid;
    grid-template-columns:repeat(6,1fr);
  }
  .metric{
    padding:22px 18px;
    border-right:1px solid var(--rule-dark);
    color:#E7EBEF;
  }
  .metric:last-child{border-right:none;}
  .metric .val{
    font-family:var(--display);
    font-weight:600;
    font-size:30px;
    letter-spacing:-.01em;
    line-height:1;
    color:#fff;
  }
  .metric .lbl{
    font-family:var(--mono);
    font-size:10.5px;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#8C99A4;
    margin-top:9px;
    line-height:1.35;
  }

  /* ---------- document body ---------- */
  section.doc{padding:56px 0 8px;}

  .sec-head{
    display:flex;align-items:baseline;gap:16px;
    border-bottom:2px solid var(--ink);
    padding-bottom:12px;margin-bottom:30px;
  }
  .sec-num{
    font-family:var(--mono);
    font-weight:600;
    font-size:14px;
    color:var(--accent);
    letter-spacing:.05em;
  }
  .sec-title{
    font-family:var(--display);
    font-weight:600;
    font-size:clamp(20px,3vw,27px);
    letter-spacing:-.01em;
  }
  .sec-title .sub{
    display:block;
    font-family:var(--mono);
    font-weight:400;
    font-size:11px;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--ink-3);
    margin-top:6px;
  }

  .situation{
    display:grid;
    grid-template-columns:1.6fr 1fr;
    gap:34px;
    align-items:start;
  }
  .situation p{
    font-size:15.5px;
    color:var(--ink-2);
    margin-bottom:14px;
  }
  .situation p strong{color:var(--ink);font-weight:600;}
  .facts{
    background:var(--surface);
    border:1px solid var(--rule);
    border-top:3px solid var(--accent);
    padding:20px 22px;
    font-family:var(--mono);
    font-size:12.5px;
  }
  .facts h4{
    font-family:var(--mono);
    font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;
    color:var(--accent);margin-bottom:14px;font-weight:600;
  }
  .facts .frow{
    display:flex;justify-content:space-between;gap:12px;
    padding:8px 0;border-bottom:1px dashed var(--rule);
    color:var(--ink-2);
  }
  .facts .frow:last-child{border-bottom:none;}
  .facts .frow b{color:var(--ink);font-weight:600;text-align:right;}

  /* work product cards */
  .products{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
  }
  .card{
    background:var(--surface);
    border:1px solid var(--rule);
    padding:26px 26px 24px;
    display:flex;flex-direction:column;
    transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
    position:relative;
  }
  .card:hover{
    transform:translateY(-3px);
    box-shadow:0 14px 30px -18px rgba(19,23,30,.45);
    border-color:var(--accent);
  }
  .card .tag{
    font-family:var(--mono);
    font-size:11px;letter-spacing:.1em;
    color:var(--accent);font-weight:600;
    margin-bottom:12px;
    display:flex;align-items:center;gap:10px;
  }
  .card .tag::after{content:"";height:1px;flex:1;background:var(--rule);}
  .card h3{
    font-family:var(--display);
    font-weight:600;font-size:20px;
    letter-spacing:-.01em;line-height:1.15;
    margin-bottom:12px;
  }
  .card p{
    font-size:14px;color:var(--ink-2);margin-bottom:16px;
  }
  .card .meta{
    margin-top:auto;
    border-top:1px solid var(--rule);
    padding-top:14px;
    display:flex;flex-direction:column;gap:8px;
  }
  .card .mrow{
    display:flex;gap:10px;font-family:var(--mono);font-size:11.5px;
    color:var(--ink-2);line-height:1.4;
  }
  .card .mrow .mk{
    color:var(--accent);letter-spacing:.06em;
    text-transform:uppercase;font-size:10px;
    min-width:64px;padding-top:1px;font-weight:600;
  }

  /* impact */
  .impact{
    background:var(--surface);
    border:1px solid var(--rule);
    border-left:3px solid var(--accent);
    padding:0;
  }
  .impact .irow{
    display:grid;
    grid-template-columns:220px 1fr;
    border-bottom:1px solid var(--rule);
    align-items:center;
  }
  .impact .irow:last-child{border-bottom:none;}
  .impact .istate{
    padding:18px 22px;
    font-family:var(--mono);
    font-size:11px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--ink-3);
    border-right:1px solid var(--rule);
    background:var(--surface-2);
  }
  .impact .istate b{
    display:block;font-family:var(--display);font-size:22px;
    letter-spacing:-.01em;color:var(--ink);margin-bottom:3px;
    text-transform:none;
  }
  .impact .idesc{padding:18px 24px;font-size:14.5px;color:var(--ink-2);}
  .impact .idesc strong{color:var(--ink);font-weight:600;}

  /* capability */
  .caps{
    display:grid;grid-template-columns:repeat(3,1fr);gap:16px;
  }
  .capcol{
    background:var(--surface);
    border:1px solid var(--rule);
    padding:20px 20px 16px;
  }
  .capcol h4{
    font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--accent);
    padding-bottom:12px;margin-bottom:12px;
    border-bottom:1px solid var(--rule);font-weight:600;
  }
  .capcol ul{list-style:none;}
  .capcol li{
    font-size:13.5px;color:var(--ink-2);
    padding:5px 0 5px 16px;position:relative;
  }
  .capcol li::before{
    content:"";position:absolute;left:0;top:12px;
    width:5px;height:5px;background:var(--accent);
  }

  /* footer */
  .footer{
    margin-top:56px;
    background:var(--cover);
    color:#C6CED6;
    border-top:3px solid var(--accent);
  }
  .footer .wrap{padding:44px 24px 40px;}
  .foot-grid{
    display:grid;grid-template-columns:1.4fr 1fr;gap:34px;
    align-items:start;
  }
  .footer h4{
    font-family:var(--mono);font-size:11px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--accent);margin-bottom:16px;
  }
  .footer .contact a{
    display:block;font-family:var(--mono);font-size:13.5px;
    color:#E7EBEF;text-decoration:none;padding:5px 0;
    border-bottom:1px solid var(--rule-dark);width:fit-content;
    transition:color .15s ease;
  }
  .footer .contact a:hover{color:var(--accent);}
  .footer .creds p{
    font-size:13.5px;color:#AEB8C1;margin-bottom:10px;line-height:1.45;
  }
  .footer .creds b{color:#E7EBEF;font-weight:600;}
  .caveat{
    margin-top:34px;padding-top:20px;border-top:1px solid var(--rule-dark);
    font-family:var(--mono);font-size:11px;letter-spacing:.06em;
    color:#8C99A4;line-height:1.6;
  }


  /* ---- dashboard section ---- */
  .db-bluf{
    background:var(--accent-soft);border:1px solid #BEDDD1;border-left:3px solid var(--accent);
    padding:16px 20px;margin-bottom:26px;font-size:14.5px;color:var(--ink);
  }
  .db-bluf b{color:var(--accent-deep);font-weight:600;}
  .db-bluf .lead{font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);display:block;margin-bottom:6px;}
  .db-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:1px solid var(--rule);margin-bottom:26px;background:var(--surface);}
  .db-kpi{padding:18px 20px;border-right:1px solid var(--rule);}
  .db-kpi:last-child{border-right:none;}
  .db-kpi .k{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);margin-bottom:8px;line-height:1.3;}
  .db-kpi .v{font-family:var(--display);font-weight:600;font-size:26px;letter-spacing:-.01em;line-height:1;color:var(--ink);}
  .db-kpi .v small{font-size:14px;color:var(--ink-2);font-weight:500;}
  .db-chart{background:var(--surface);border:1px solid var(--rule);padding:22px 24px 14px;margin-bottom:26px;}
  .db-chart .ct{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:10px;margin-bottom:6px;}
  .db-chart .ct h4{font-family:var(--display);font-size:16px;font-weight:600;}
  .db-legend{display:flex;gap:18px;font-family:var(--mono);font-size:11px;color:var(--ink-2);}
  .db-legend span{display:flex;align-items:center;gap:7px;}
  .db-legend i{width:16px;height:0;border-top:2px solid var(--accent);display:inline-block;}
  .db-legend i.plan{border-top:2px dashed var(--steel);}
  .db-svg{width:100%;height:auto;display:block;margin-top:8px;}
  .db-grid{stroke:var(--rule);stroke-width:1;}
  .db-actual{fill:none;stroke:var(--accent);stroke-width:2.4;}
  .db-planned{fill:none;stroke:var(--steel);stroke-width:1.8;stroke-dasharray:5 4;opacity:.85;}
  .db-dot{fill:var(--accent);}
  .db-xlab{font-family:var(--mono);font-size:10px;fill:var(--ink-3);text-anchor:middle;}
  .db-ylab{font-family:var(--mono);font-size:10px;fill:var(--ink-3);text-anchor:end;}
  .db-cap{font-family:var(--mono);font-size:11px;color:var(--ink-3);line-height:1.5;margin-top:2px;}
  .db-comp{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:8px;}
  .db-cbox{background:var(--surface);border:1px solid var(--rule);padding:20px 22px;}
  .db-cbox h4{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);margin-bottom:16px;}
  .db-bar{margin-bottom:14px;}
  .db-bar .bl{display:flex;justify-content:space-between;font-family:var(--mono);font-size:12px;margin-bottom:5px;color:var(--ink-2);}
  .db-bar .bl b{color:var(--ink);font-weight:600;}
  .db-track{height:9px;background:var(--surface-2);border:1px solid var(--rule);position:relative;overflow:hidden;}
  .db-fill{height:100%;background:var(--accent);}
  .db-fill.steel{background:var(--steel);}
  .db-fill.amber{background:var(--signal);}
  .db-handling{font-family:var(--mono);font-size:11px;color:var(--ink-3);border-top:1px dashed var(--rule);padding-top:14px;margin-top:4px;line-height:1.6;}
  @media(max-width:820px){
    .db-kpis{grid-template-columns:1fr 1fr;}
    .db-kpi:nth-child(2){border-right:none;}
    .db-kpi{border-bottom:1px solid var(--rule);}
    .db-comp{grid-template-columns:1fr;}
  }


  /* analytic approach band */
  .approach{background:var(--surface);border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);}
  .approach .wrap{padding:30px 24px;}
  .ap-head{font-size:16px;color:var(--ink);margin-bottom:20px;font-weight:500;}
  .ap-head .ap-k{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);margin-bottom:8px;font-weight:600;}
  .ap-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  .ap-chip{border:1px solid var(--rule);border-top:2px solid var(--accent);padding:14px 16px;font-size:13px;color:var(--ink-2);line-height:1.45;}
  .ap-chip b{display:block;font-family:var(--display);font-size:14px;color:var(--ink);margin-bottom:6px;font-weight:600;}
  /* tabs */
  .tabs{display:flex;flex-wrap:wrap;gap:2px;border-bottom:2px solid var(--ink);margin-bottom:0;}
  .tab{font-family:var(--mono);font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-2);
    background:var(--surface-2);border:1px solid var(--rule);border-bottom:none;padding:11px 16px;cursor:pointer;
    transition:background .15s,color .15s;position:relative;top:2px;}
  .tab:hover{color:var(--ink);}
  .tab.active{background:var(--ink);color:#fff;border-color:var(--ink);}
  .panel-wrap{border:1px solid var(--rule);border-top:none;background:var(--surface);padding:26px 24px;}
  .panel{display:none;}
  .panel.active{display:block;animation:fadein .3s ease;}
  @keyframes fadein{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:none;}}
  .ov-split{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:22px;}
  .db-cbox.nb{border:none;padding:0;}
  /* chart host */
  .chart-host{position:relative;}
  #burnSvg{width:100%;height:auto;display:block;cursor:crosshair;}
  .lg{background:none;border:none;font-family:var(--mono);font-size:11px;color:var(--ink-2);cursor:pointer;display:flex;align-items:center;gap:7px;padding:2px 4px;opacity:1;}
  .lg.off{opacity:.35;text-decoration:line-through;}
  .lg i{width:16px;height:0;border-top:2px solid var(--accent);display:inline-block;}
  .lg i.plan{border-top:2px dashed var(--steel);}
  .tip{position:absolute;pointer-events:none;background:var(--ink);color:#fff;font-family:var(--mono);font-size:11px;
    padding:8px 10px;border-radius:3px;line-height:1.5;white-space:nowrap;transform:translate(-50%,-120%);z-index:5;box-shadow:0 6px 18px -6px rgba(0,0,0,.5);}
  .tip b{color:var(--signal);}
  .tip .a{color:#7FD9C0;}.tip .p{color:#9DBBD8;}
  /* table */
  .tbl-host{overflow-x:auto;}
  .xtbl{width:100%;border-collapse:collapse;font-size:13px;}
  .xtbl th{font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-2);
    text-align:right;padding:10px 12px;border-bottom:2px solid var(--rule);cursor:pointer;white-space:nowrap;user-select:none;}
  .xtbl th.lft{text-align:left;}
  .xtbl th:hover{color:var(--accent);}
  .xtbl th.sorted::after{content:" \25BE";color:var(--accent);}
  .xtbl th.sorted.asc::after{content:" \25B4";color:var(--accent);}
  .xtbl td{padding:9px 12px;text-align:right;border-bottom:1px solid var(--rule);font-family:var(--mono);color:var(--ink-2);}
  .xtbl td.lft{text-align:left;color:var(--ink);font-family:var(--body);font-weight:500;}
  .xtbl tbody tr:hover{background:var(--surface-2);}
  .xtbl td.pos{color:var(--accent);}
  /* bar rows */
  .brow{margin-bottom:14px;}
  .brow .bl{display:flex;justify-content:space-between;font-family:var(--mono);font-size:12px;margin-bottom:5px;color:var(--ink-2);}
  .brow .bl b{color:var(--ink);font-weight:600;}
  .btrack{height:22px;background:var(--surface-2);border:1px solid var(--rule);position:relative;overflow:hidden;}
  .bfill{height:100%;background:var(--accent);transition:width .5s ease;display:flex;align-items:center;}
  .bfill.steel{background:var(--steel);}
  .bfill.amber{background:var(--signal);}
  .bsub{font-family:var(--mono);font-size:10px;color:#fff;padding-left:8px;opacity:.9;white-space:nowrap;}
  @media(max-width:820px){
    .ap-grid{grid-template-columns:1fr 1fr;}
    .ov-split{grid-template-columns:1fr;}
    .tab{flex:1 1 auto;text-align:center;}
  }
  @media(max-width:480px){.ap-grid{grid-template-columns:1fr;}}


  /* pace gauges */
  .pace{border:1px solid var(--rule);border-left:3px solid var(--signal);background:var(--surface-2);padding:20px 22px;margin-bottom:22px;}
  .pace-head{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2);margin-bottom:16px;}
  .gauge{margin-bottom:14px;}
  .gauge .gl{display:flex;justify-content:space-between;font-family:var(--mono);font-size:12px;color:var(--ink-2);margin-bottom:5px;}
  .gauge .gl b{color:var(--ink);font-size:14px;}
  .gtrack{height:16px;background:#fff;border:1px solid var(--rule);overflow:hidden;}
  .gfill{height:100%;background:var(--accent);width:0;transition:width .7s ease;}
  .gfill.amber{background:var(--signal);}
  .pace-note{font-size:13.5px;color:var(--ink);margin-top:12px;padding-top:12px;border-top:1px dashed var(--rule);}
  .pace-note b{color:var(--accent-deep);font-weight:600;}
  .ov2{display:grid;grid-template-columns:1.3fr 1fr;gap:20px;margin-bottom:20px;}
